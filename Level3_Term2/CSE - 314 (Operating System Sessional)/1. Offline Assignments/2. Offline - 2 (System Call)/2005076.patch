+void print_trace(struct proc *p, int num){
+  int arg1=0, arg2=0, arg3=0;
+  uint64 arg_addr;
+  char str1[100], str2[100];
+
+  switch(num){
+    case SYS_fork: //(void)
+    case SYS_getpid:
+    case SYS_uptime:
+      printf("pid: %d, syscall: %s, args: (), ", p->pid, syscall_names[num-1]);
+      return;
+
+    case SYS_exit:   //(int)
+    case SYS_close:
+    case SYS_kill:
+    case SYS_dup:
+    case SYS_sleep:
+      argint(0, &arg1);
+      printf("pid: %d, syscall: %s, args: (%d), ", p->pid, syscall_names[num-1], arg1);
+      return;
+    
+    case SYS_wait:   //(int*)
+    case SYS_pipe:
+      argaddr(0, &arg_addr);
+      printf("pid: %d, syscall: %s, args: (%p), ", p->pid, syscall_names[num-1], (void*)arg_addr);
+      return;
+
+    case SYS_read:   //(int, void*, int)
+    case SYS_write:
+      argint(0, &arg1);
+      argaddr(1, &arg_addr);
+      argint(2, &arg3);
+      printf("pid: %d, syscall: %s, args: (%d, %p, %d), ", p->pid, syscall_names[num-1], arg1, (void*)arg_addr, arg3);
+      return;
+
+    case SYS_unlink: //(const char*)
+    case SYS_mkdir:
+    case SYS_chdir:
+      argstr(0, str1, 100);
+      printf("pid: %d, syscall: %s, args: (%s), ", p->pid, syscall_names[num-1], str1);
+      return;
+    
+    case SYS_link:   //(const char*, const char*)
+      argstr(0, str1, 100);
+      argstr(1, str2, 100);
+      printf("pid: %d, syscall: %s, args: (%s, %s), ", p->pid, syscall_names[num-1], str1, str2);
+      return;
+    
+    case SYS_open:   //(const char*, int)
+      int flag = argstr(0, str1, sizeof(str1));
+      printf("flag: %d\n", flag);
+      printf("argstr: %s\n", str1);
+      argint(1, &arg2);
+      printf("pid: %d, syscall: %s, args: (%s, %d), ", p->pid, syscall_names[num-1], str1, arg2);
+      return;
+    
+    case SYS_mknod:  //(const char*, short, short)
+      argstr(0, str1, 100);
+      argint(1, &arg2);
+      argint(2, &arg3);
+      printf("pid: %d, syscall: %s, args: (%s, %d, %d), ", p->pid, syscall_names[num-1], str1, arg2, arg3);
+      return;
+    
+    case SYS_fstat:  //(int, struct stat*)
+      argint(0, &arg1);
+      argaddr(1, &arg_addr);
+      printf("pid: %d, syscall: %s, args: (%d, %p), ", p->pid, syscall_names[num-1], arg1, (void*)arg_addr);
+      return;
+    
+    case SYS_sbrk:   //(int)
+      argint(0, &arg1);
+      printf("pid: %d, syscall: %s, args: (%d), ", p->pid, syscall_names[num-1], arg1);
+      return;
+    
+    case SYS_exec:   //(const char*, char**)
+      uint64 addr;
+      argaddr(0, &addr);
+      copyin(p->pagetable, (char*)str1, addr, 100);
+      printf("str1: %s\n", str1);
+      // argstr(0, str1, 100);
+      argaddr(1, &arg_addr);
+      printf("pid: %d, syscall: %s, args: (%s, %p), ", p->pid, syscall_names[num-1], str1, (void*)arg_addr);
+      return;
+
+    default:
+      argint(0, &arg1);
+      argint(1, &arg2);
+      argint(2, &arg3);
+      printf("pid: %d, syscall: unknown, args: (%d, %d, %d), ", p->pid, arg1, arg2, arg3);
+  }
+
+}
