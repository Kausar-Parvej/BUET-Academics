+
+// added by me
+int proc_info(uint64 userInfo_addr){
+  struct procInfo kernel_info;
+
+  struct proc *pr;
+
+  acquire(&info_lock);
+
+  kernel_info.activeProcess = 0;
+  kernel_info.totalProcess = NPROC;
+  kernel_info.memsize = 0;
+  kernel_info.totalMemSize = PHYSTOP - KERNBASE;
+
+  for(pr = proc; pr < &proc[NPROC]; pr++){
+    if(pr->state == RUNNING || pr->state == RUNNABLE || pr->state == SLEEPING){
+      kernel_info.activeProcess++;
+      kernel_info.memsize += pr->sz;
+      printf("Process %d: %s\n", pr->pid, pr->name);
+    }
+  }
+
+  if(copyout(myproc()->pagetable, userInfo_addr, (char*) &kernel_info, sizeof(kernel_info)) < 0){
+    release(&info_lock);
+    return -1;
+  }
+  release(&info_lock);
+  return 0;
+}
+
+int set_cmd(char *cmd){
+  acquire(&cmd_lock);
+  safestrcpy(last_command[top], cmd, sizeof(last_command));
+  top = (top + 1) % MAXCMD_HISTORY;
+  release(&cmd_lock);
+  return 0;
+}
+
+int get_cmd(uint64 cmd_addr, int nth){
+  if(nth <= 0 || top - nth < 0){
+    return -1;
+  }
+  if(last_command[top-nth][0] == '\0'){
+    return -1;
+  }
+  acquire(&cmd_lock);
+  if(copyout(myproc()->pagetable, cmd_addr, last_command[top-nth], sizeof(last_command[top-nth])) < 0){
+    release(&cmd_lock);
+    return -1;
+  }
+  release(&cmd_lock);
+  return 0;
+}
