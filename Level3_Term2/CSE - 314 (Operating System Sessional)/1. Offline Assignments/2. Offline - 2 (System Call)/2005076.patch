new file mode 100644
index 0000000..d21aac7
--- /dev/null
+++ b/user/trace.c
@@ -0,0 +1,31 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+int main(int argc, char *argv[]){
+    if(argc < 3){
+        fprintf(2, "Use: trace <syscall num> <command>\n");
+        exit(1);
+    }
+
+    if(argv[1][0] < '0' || argv[1][0] > '9'){
+        fprintf(2, "Invalid syscall number\n");
+        exit(1);
+    }
+
+    int syscall_num = atoi(argv[1]);
+    if(syscall_num < 0 || syscall_num > 64){
+        fprintf(2, "Invalid syscall number\n");
+        exit(1);
+    }
+
+    if(trace(syscall_num) < 0){
+        fprintf(2, "Failed to trace %s\n", argv[0]);
+        exit(1);
+    }
+
+    exec(argv[2], argv + 2);
+    fprintf(2, "Failed to execute %s\n", argv[2]);
+    exit(1);
+
+}
