diff --git a/user/load.c b/user/load.c
new file mode 100644
index 0000000..f18f9ee
--- /dev/null
+++ b/user/load.c
@@ -0,0 +1,44 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "kernel/param.h"
+#include "user/user.h"
+
+int main(int argc, char *argv[]) {
+    if (argc != 3) {
+        fprintf(2, "Usage: load <childCount> <allocationAmount>\n");
+        exit(1);
+    }
+
+    int childCount = atoi(argv[1]);
+    int allocationAmount = atoi(argv[2]);
+
+
+    for(int i=0; i<childCount; i++){
+        int pid = fork();
+        if(pid == 0){
+            printf("Child %d is created\n", i+1);
+            void *ptr = malloc(allocationAmount);
+            printf("Child %d allocated %d bytes\n", i+1, allocationAmount);
+            printf("Child %d is going to sleep\n", i+1);
+
+            sleep(200);
+            free(ptr);
+            exit(0);
+        }
+        sleep(5);
+        
+    }
+    printf("Parent is going to sleep\n");
+    sleep(10);
+    printf("Parent woke up\n");
+
+    struct procInfo pr_info;
+    if(info(&pr_info) == 0){
+        printf("\nCurrent system informatin:\n");
+        printf("Processes: %d/%d\n", pr_info.activeProcess, pr_info.totalProcess);
+        printf("RAM: %d/%d (in KB)\n", pr_info.memsize/1024, pr_info.totalMemSize/1024);
+    }
+
+    exit(0);
+
+}
