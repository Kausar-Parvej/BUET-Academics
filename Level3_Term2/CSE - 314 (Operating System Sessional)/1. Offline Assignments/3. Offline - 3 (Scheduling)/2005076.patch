--- /dev/null
+++ b/kernel/pstat.h
@@ -0,0 +1,18 @@
+#ifndef _PSTAT_H_
+#define _PSTAT_H_
+
+#include "param.h"
+
+struct pstat {
+    int pid[NPROC];                 // Process IDs
+    int inuse[NPROC];               // Whether the process slot is in use
+    int inQ[NPROC];                 // Queue level of each process (0 or 1)
+    int waiting_time[NPROC];        // Time spent waiting in queue
+    int running_time[NPROC];        // Total running time
+    int times_scheduled[NPROC];     // Number of times scheduled
+    int tickets_original[NPROC];    // Original ticket count
+    int tickets_current[NPROC];     // Current ticket count in Queue 0
+    uint queue_ticks[NPROC][2];     // Ticks spent in each queue level (0 and 1)
+};
+
+#endif // _PSTAT_H_
