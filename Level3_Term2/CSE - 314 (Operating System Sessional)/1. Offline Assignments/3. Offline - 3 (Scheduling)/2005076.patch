+int getpinfo(struct pstat *statptr) {
+  struct proc *p;
+  int i = 0;
+
+  struct proc *mp = myproc();
+  struct pstat p_stat;
+
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    p_stat.pid[i] = p->pid;
+
+    if(p->state == RUNNING || p->state == RUNNABLE) p_stat.inuse[i] = 1;
+    else if(p->state == SLEEPING) p_stat.inuse[i] = 0;
+    else p_stat.inuse[i] = -1;
+
+    p_stat.inQ[i] = p->queue_level;
+    p_stat.waiting_time[i] = p->waiting_time;
+    p_stat.running_time[i] = p->ticks_used;
+    p_stat.times_scheduled[i] = p->times_scheduled;
+    p_stat.tickets_original[i] = p->tickets_original;
+    p_stat.tickets_current[i] = p->tickets_num;
+    p_stat.queue_ticks[i][0] = p->queue_ticks[0];
+    p_stat.queue_ticks[i][1] = p->queue_ticks[1];
+    release(&p->lock);
+    i++;
+  }
+
+  if(copyout(mp->pagetable, (uint64)statptr, (char *)&p_stat, sizeof(p_stat)) < 0)
+    return -1;
+  return 0;
+}
+
+int settickets(int number){
+  struct proc *p = myproc();
+  acquire(&p->lock);
+  p->tickets_original = number;
+  p->tickets_num = number;
+  release(&p->lock);
+  return 0;
+}
+
+int toggle_log(){
+  print_log = !print_log;
+  return 0;
+}
