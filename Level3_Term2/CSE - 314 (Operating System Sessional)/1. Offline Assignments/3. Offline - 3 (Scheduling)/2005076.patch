@@ -0,0 +1,38 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/pstat.h"
+
+int temp[100];
+int main(int argc, char *argv[]) {
+    if(argc < 2){
+    fprintf(2, "Usage: %s num num\n", argv[0]);
+    exit(1);
+    }
+
+
+    int tickets = atoi(argv[1]);
+    int iterations = atoi(argv[2]);
+    if(settickets(tickets) < 0){
+        fprintf(2, "Usage: %s - give a valid number\n", argv[0]);
+        exit(1);
+    }
+
+    int pid1 = fork();
+    //fork();
+    if(iterations > 2000000000) iterations = 2000000000;
+    for(int i = 0; i < iterations; i++){
+        temp[i % 100] += 1;
+        if( pid1 != 0 && (i % (iterations/10)) == 0){
+            sleep(5);
+        }
+    }
+
+
+    exit(0);
+}
+
