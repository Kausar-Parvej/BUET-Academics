+uint64
+sys_thread_create(void)
+{
+  uint64 fcn, arg, stack;
+  
+  argaddr(0, &fcn);
+  argaddr(1, &arg);
+  argaddr(2, &stack);
+  
+  return thread_create((void(*)(void*))fcn, (void*)arg, (void*)stack);
+}
+
+uint64
+sys_thread_join(void)
+{
+  int thread_id;
+  argint(0, &thread_id);
